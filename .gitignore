# Corpora: hundreds of megabytes of .bin, rebuilt by `python3 -m corpora.*`
data_*/

# The weights directory
weights/*
!weights/manifest.json

# Trained checkpoints stay on the machine that trained them.
# GitHub rejects any file over 100 MB, and optim.npz is 436 MB.
# The six full folders are about 61 GB. Identities are in RESEARCH.md
# and research/checkpoints/.
weights_csulb/
weights_csulb_65min/
weights_csulb_h2/
weights_csulb_h4/
weights_csulb_h6/
weights_mine/

# Run artefacts: logs, checkpoints, plots
runs/*
!runs/samples.txt

__pycache__/
*.pyc

# the training corpus - 1.2 GB of text, regenerated by tools/expand_corpus.py
data/
runs/corpus_index.json

# secrets
.env
.env.*
